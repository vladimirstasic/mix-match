DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mix_match
REDIS_URL=redis://localhost:6379
ACRCLOUD_HOST=identify-eu-west-1.acrcloud.com
ACRCLOUD_ACCESS_KEY=your_access_key
ACRCLOUD_ACCESS_SECRET=your_access_secret
UPLOAD_DIR=/tmp/mix-match
PORT=3001
CLERK_PUBLISHABLE_KEY=pk_test_your_key
CLERK_SECRET_KEY=sk_test_your_key
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# File Scanning (async, internal/admin-only engine — see plan docs). Optional:
# the real-time recognition path works without these.
ACRCLOUD_CONSOLE_TOKEN=
ACRCLOUD_FILESCAN_CONTAINER_ID=30969
ACRCLOUD_FILESCAN_REGION=eu-west-1
ACRCLOUD_FILESCAN_WEBHOOK_SECRET=
PUBLIC_API_URL=https://mix-match-production.up.railway.app

# Affiliate tags (web build-time, public). Leave empty to render plain "buy"
# search links; fill in once approved to start earning. These belong in the web
# build env (Vite VITE_*).
# VITE_AFF_AMAZON=    # Amazon Associates tag, e.g. yourtag-20
# VITE_AFF_APPLE=     # Apple Services Performance Partners token (largely deprecated)
# VITE_AFF_BEATPORT=  # Beatport/Impact — reserved; real attribution needs Impact deep-links

